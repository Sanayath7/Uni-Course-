import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.sql.*;

public class RegistrationForm extends JFrame {

    private JTextField nameField, emailField, phoneField, dobField;
    private JTextArea addressArea;
    private JPasswordField passwordField, confirmPasswordField;
    private JCheckBox showPasswordCheck, termsCheck;
    private JRadioButton maleBtn, femaleBtn, otherBtn;
    private JComboBox<String> roleCombo;
    private ButtonGroup genderGroup;

    public RegistrationForm() {
        setTitle("User Registration");
        setSize(500, 650);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        try {
            setIconImage(Toolkit.getDefaultToolkit().getImage(getClass().getResource("icon.png")));
        } catch (Exception e) {
            System.out.println("Icon not found, using default");
        }

        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBackground(new Color(255, 255, 200));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 10, 8, 10);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Name
        addLabelAndField(panel, gbc, 0, "Name:", nameField = new JTextField(20));

        // Email
        addLabelAndField(panel, gbc, 1, "Email:", emailField = new JTextField(20));

        // Phone
        addLabelAndField(panel, gbc, 2, "Phone:", phoneField = new JTextField(10));

        // Date of Birth
        addLabelAndField(panel, gbc, 3, "Date of Birth:", dobField = new JTextField("DD-MM-YYYY", 10));

        // Address
        gbc.gridx = 0; gbc.gridy = 4;
        panel.add(new JLabel("Address:"), gbc);
        gbc.gridx = 1;
        addressArea = new JTextArea(3, 20);
        addressArea.setLineWrap(true);
        JScrollPane scrollPane = new JScrollPane(addressArea);
        panel.add(scrollPane, gbc);

        // Gender
        gbc.gridx = 0; gbc.gridy = 5;
        panel.add(new JLabel("Gender:"), gbc);
        gbc.gridx = 1;
        JPanel genderPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        genderPanel.setBackground(panel.getBackground());

        maleBtn = new JRadioButton("Male");
        femaleBtn = new JRadioButton("Female");
        otherBtn = new JRadioButton("Other");

        genderGroup = new ButtonGroup();
        genderGroup.add(maleBtn);
        genderGroup.add(femaleBtn);
        genderGroup.add(otherBtn);

        genderPanel.add(maleBtn);
        genderPanel.add(femaleBtn);
        genderPanel.add(otherBtn);
        panel.add(genderPanel, gbc);

        // Role
        gbc.gridx = 0; gbc.gridy = 6;
        panel.add(new JLabel("Role:"), gbc);
        gbc.gridx = 1;
        roleCombo = new JComboBox<>(new String[]{"User", "Admin", "Guest"});
        panel.add(roleCombo, gbc);

        // Password
        addLabelAndField(panel, gbc, 7, "Password:", passwordField = new JPasswordField(20));

        // Confirm Password
        addLabelAndField(panel, gbc, 8, "Confirm Password:", confirmPasswordField = new JPasswordField(20));

        // Show Password
        gbc.gridx = 1; gbc.gridy = 9;
        showPasswordCheck = new JCheckBox("Show Passwords");
        showPasswordCheck.setBackground(panel.getBackground());
        showPasswordCheck.addActionListener(e -> {
            boolean visible = showPasswordCheck.isSelected();
            passwordField.setEchoChar(visible ? (char) 0 : '•');
            confirmPasswordField.setEchoChar(visible ? (char) 0 : '•');
        });
        panel.add(showPasswordCheck, gbc);

        // Terms
        gbc.gridx = 1; gbc.gridy = 10;
        termsCheck = new JCheckBox("I agree to the Terms and Conditions.");
        termsCheck.setBackground(panel.getBackground());
        panel.add(termsCheck, gbc);

        // Buttons Panel
        gbc.gridx = 1; gbc.gridy = 11;
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 10, 0));
        buttonPanel.setBackground(panel.getBackground());

        JButton registerBtn = new JButton("Register");
        registerBtn.addActionListener(e -> registerUser());

        JButton resetBtn = new JButton("Reset");
        resetBtn.addActionListener(e -> clearFields());

        buttonPanel.add(registerBtn);
        buttonPanel.add(resetBtn);
        panel.add(buttonPanel, gbc);

        add(panel);
        setVisible(true);
    }

    private void addLabelAndField(JPanel panel, GridBagConstraints gbc, int row, String labelText, JComponent field) {
        gbc.gridx = 0; gbc.gridy = row;
        panel.add(new JLabel(labelText), gbc);
        gbc.gridx = 1;
        panel.add(field, gbc);
    }

    private void registerUser() {
        String name = nameField.getText().trim();
        String email = emailField.getText().trim();
        String phone = phoneField.getText().trim();
        String dob = dobField.getText().trim();
        String address = addressArea.getText().trim();
        String password = new String(passwordField.getPassword());
        String confirmPassword = new String(confirmPasswordField.getPassword());
        String gender = maleBtn.isSelected() ? "Male" : femaleBtn.isSelected() ? "Female" : otherBtn.isSelected() ? "Other" : "";
        String role = (String) roleCombo.getSelectedItem();

        if (name.isEmpty() || !name.matches("[A-Za-z\\s]+")) {
            showError("Name must contain only letters and cannot be empty.");
            return;
        }

        if (email.isEmpty() || !email.matches("^[\\w.-]+@[\\w.-]+\\.\\w{2,}$")) {
            showError("Invalid email format.");
            return;
        }

        if (phone.isEmpty() || !phone.matches("\\d{10}")) {
            showError("Phone must be 10 digits.");
            return;
        }

        if (dob.isEmpty() || !dob.matches("\\d{2}-\\d{2}-\\d{4}")) {
            showError("Please enter valid DOB in DD-MM-YYYY format.");
            return;
        }

        if (address.isEmpty()) {
            showError("Please enter your address.");
            return;
        }

        if (gender.isEmpty()) {
            showError("Please select a gender.");
            return;
        }

        if (password.isEmpty() || password.length() < 6) {
            showError("Password must be at least 6 characters.");
            return;
        }

        if (!password.equals(confirmPassword)) {
            showError("Passwords do not match.");
            return;
        }

        if (!termsCheck.isSelected()) {
            showError("Please accept the terms and conditions.");
            return;
        }

        try (Connection conn = DBConnection.getConnection()) {
            String sql = "INSERT INTO users (name, email, phone, dob, address, gender, role, password) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
            PreparedStatement stmt = conn.prepareStatement(sql);
            stmt.setString(1, name);
            stmt.setString(2, email);
            stmt.setString(3, phone);
            stmt.setString(4, dob);
            stmt.setString(5, address);
            stmt.setString(6, gender);
            stmt.setString(7, role);
            stmt.setString(8, password);

            int rowsAffected = stmt.executeUpdate();
            if (rowsAffected > 0) {
                JOptionPane.showMessageDialog(this, "Registration successful!", "Success", JOptionPane.INFORMATION_MESSAGE);
                openWelcomeScreen(name);
                clearFields();
            }
        } catch (SQLIntegrityConstraintViolationException ex) {
            showError("Email or phone already registered.");
        } catch (SQLException ex) {
            showError("Database error: " + ex.getMessage());
            ex.printStackTrace();
        } catch (Exception ex) {
            showError("Error: " + ex.getMessage());
            ex.printStackTrace();
        }
    }

    private void showError(String message) {
        JOptionPane.showMessageDialog(this, message, "Error", JOptionPane.ERROR_MESSAGE);
    }

    private void clearFields() {
        nameField.setText("");
        emailField.setText("");
        phoneField.setText("");
        dobField.setText("DD-MM-YYYY");
        addressArea.setText("");
        passwordField.setText("");
        confirmPasswordField.setText("");
        genderGroup.clearSelection();
        roleCombo.setSelectedIndex(0);
        termsCheck.setSelected(false);
        showPasswordCheck.setSelected(false);
        passwordField.setEchoChar('•');
        confirmPasswordField.setEchoChar('•');
        nameField.requestFocus();
    }

    private void openWelcomeScreen(String name) {
        JFrame welcomeFrame = new JFrame("Welcome");
        welcomeFrame.setSize(300, 150);
        welcomeFrame.setLocationRelativeTo(null);
        welcomeFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

        JLabel welcomeLabel = new JLabel("Welcome, " + name + "!", SwingConstants.CENTER);
        welcomeLabel.setFont(new Font("Arial", Font.BOLD, 16));
        welcomeFrame.add(welcomeLabel);

        welcomeFrame.setVisible(true);
    }


    static class DBConnection {      // Nested DBConnection class (eikhane no separate file needed)
        public static Connection getConnection() throws SQLException {
            String url = "jdbc:mysql://localhost:3306/your_database";
            String username = "your_username";
            String password = "your_password";
            return DriverManager.getConnection(url, username, password);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            try {
                UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            } catch (Exception e) {
                e.printStackTrace();
            }
            new RegistrationForm();
        });
    }
}
